# =========================================================
# WhyNotGrace Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =========================================================

APP_ENV=development
# development | staging | production
DEBUG=true
APP_NAME=WhyNotGrace
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
POSTGRES_DB=whynotgrace
POSTGRES_USER=whynotgrace
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# psycopg3 driver, built from the pieces above if DATABASE_URL is not set
DATABASE_URL=postgresql+psycopg://whynotgrace:changeme_dev_password@localhost:5432/whynotgrace

# Per-process SQLAlchemy pool (see backend/README.md's "Scaling beyond one
# process" section for the worker x pool math). These defaults are safe for
# a single-process deployment; tune them together with UVICORN_WORKERS.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

# Separate DB pool + request-thread budget for the public QR endpoints ONLY
# (app/api/qr.py) — everything else uses DB_POOL_SIZE/DB_POOL_MAX_OVERFLOW
# above. This isolates the staff dashboard from a QR traffic surge; see
# backend/README.md's "Dashboard isolation from QR traffic" section.
QR_DB_POOL_SIZE=10
QR_DB_POOL_MAX_OVERFLOW=20
QR_MAX_CONCURRENT_REQUESTS=30

# ---------------------------------------------------------
# Redis (Phase 11 — optional; unset = caching and distributed rate limiting
# both fully disabled, and the app behaves exactly as it did before Phase 11)
# ---------------------------------------------------------
# Backs app/core/cache.py (public QR-menu read-through cache) and, if set,
# app/core/rate_limit.py's shared cross-worker/cross-instance rate limiting.
# Leave empty for a single-process deployment or when Redis isn't available —
# every cache/rate-limit operation degrades to a safe no-op / in-memory
# fallback automatically. See docker-compose.yml's `redis` service.
REDIS_URL=
PUBLIC_MENU_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------
# Reverse proxy / real client IP
# ---------------------------------------------------------
# Comma-separated IPs or CIDRs of reverse proxies allowed to set
# X-Forwarded-For, "*" to trust any peer, or "none" to state explicitly that
# nothing sits in front of this app. Empty is fine in development (nothing
# proxies localhost) but is REFUSED at startup when APP_ENV=production: an
# undeclared proxy makes every request look like it came from the proxy's own
# IP, which turns each per-client rate limit into ONE GLOBAL limit for the
# whole deployment. See app/core/client_ip.py.
TRUSTED_PROXY_IPS=

# Responses at least this many bytes are gzipped. The QR public menu is the
# reason this exists — the highest-traffic response in the system, served over
# restaurant WiFi and mobile data.
GZIP_MINIMUM_SIZE_BYTES=1000

# ---------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------
# In production this MUST be a long random secret (e.g. `openssl rand -hex 64`)
# and MUST NOT equal the literal development placeholder below.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Login lockout policy
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------
# EMAIL_BACKEND: smtp | console
# "console" is a development-only backend that logs emails instead of sending
# them. Startup fails if APP_ENV=production and EMAIL_BACKEND=console.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@whynotgrace.example
SMTP_USE_TLS=true

# ---------------------------------------------------------
# Razorpay
# ---------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------
# Zomato (placeholder - requires partner credentials)
# ---------------------------------------------------------
ZOMATO_API_BASE_URL=
ZOMATO_CLIENT_ID=
ZOMATO_CLIENT_SECRET=
ZOMATO_WEBHOOK_SECRET=

# ---------------------------------------------------------
# Swiggy (placeholder - requires partner credentials)
# ---------------------------------------------------------
SWIGGY_API_BASE_URL=
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_WEBHOOK_SECRET=

# ---------------------------------------------------------
# QR sessions
# ---------------------------------------------------------
QR_SESSION_EXPIRE_HOURS=6

# ---------------------------------------------------------
# Frontend
# ---------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
