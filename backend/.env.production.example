# =========================================================
# WhyNotGrace Backend — PRODUCTION environment reference
#
# This is a reference for what changes relative to .env.example for a
# real production deployment — it is NOT meant to be copied verbatim like
# .env.example is; every value marked CHANGE-ME must be a real secret you
# generate/obtain, never a value copied from this file.
#
# app.core.config.Settings.validate_production_safety() (called at
# startup) enforces the non-negotiable subset of this automatically and
# refuses to boot if it's violated — this file documents the full
# picture, including things that safety check can't verify for you
# (e.g. that JWT_SECRET is actually random, not just >=32 chars).
# =========================================================

APP_ENV=production
DEBUG=false

# ---------------------------------------------------------
# Database — prefer a managed PostgreSQL (RDS, Cloud SQL, etc.) over a
# self-hosted container for production. Never reuse the dev password.
# ---------------------------------------------------------
POSTGRES_DB=whynotgrace
POSTGRES_USER=whynotgrace
POSTGRES_PASSWORD=CHANGE-ME-a-real-random-password
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
# Or set DATABASE_URL directly (takes priority over the POSTGRES_* pieces
# above) if your provider gives you a full connection string instead.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---------------------------------------------------------
# Scaled deployment (docker-compose.prod.yml) — see backend/README.md's
# "Production deployment topology" section for the full picture and the
# connection-count math these feed into.
# ---------------------------------------------------------
# How many `backend` container replicas to run (docker compose ... up -d
# --scale backend=$BACKEND_REPLICAS).
BACKEND_REPLICAS=3
# uvicorn worker PROCESSES per replica.
UVICORN_WORKERS=4
# Host port the `lb` (nginx) container publishes — the ONLY published
# port in the scaled topology. Put a real domain + managed TLS in front
# of this in production; see README.
LB_PORT=80
# Per-worker pool sizes. With PgBouncer in front (docker-compose.prod.yml),
# these count against pgbouncer.ini's max_client_conn, not directly
# against Postgres's max_connections — see README for the math. The
# 5+7=12 default below is the only staff-pool config actually verified
# clean under sustained load in this project's own load testing.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=7
QR_DB_POOL_SIZE=10
QR_DB_POOL_MAX_OVERFLOW=15
QR_MAX_CONCURRENT_REQUESTS=30

# Backs app/core/cache.py (public QR-menu caching) and
# app/core/rate_limit.py's distributed rate limiting. A real, managed
# Redis in production — not the docker-compose `redis` service, which is
# fine for a single-server deployment but is itself a single point of
# failure otherwise. Leave unset and the app runs identically, just
# without cross-instance caching/rate-limit sharing.
REDIS_URL=redis://your-redis-host:6379/0

# ---------------------------------------------------------
# Reverse proxy / real client IP — REQUIRED in production
# ---------------------------------------------------------
# The app refuses to boot in production with this unset, because getting it
# wrong is silent and expensive: every IP-keyed rate limit reads its identity
# from here, and behind an undeclared proxy every request carries the proxy's
# own IP — so "20 QR orders per minute per client" quietly becomes "20 QR
# orders per minute for the entire platform, across every business".
#
# For docker-compose.prod.yml, "*" is the correct value: the backend
# publishes no host port and is reachable only through the `lb` nginx service
# on an internal compose network, so the peer address can only ever be that
# proxy. Behind a cloud load balancer on a shared network, list its real
# IP/CIDR instead. Use "none" only if this app is genuinely exposed directly
# to the internet with nothing in front of it.
TRUSTED_PROXY_IPS=*

# Responses at least this many bytes are gzipped (the QR menu above all).
GZIP_MINIMUM_SIZE_BYTES=1000

# ---------------------------------------------------------
# JWT / Auth — generate with: openssl rand -hex 64
# Rotating this invalidates every existing session (all refresh tokens
# were signed against the old value's derived encryption key too — see
# app/core/encryption.py, which derives its key from JWT_SECRET).
# ---------------------------------------------------------
JWT_SECRET=CHANGE-ME-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------
# CORS — the exact production frontend origin(s), comma-separated, no
# trailing slash. NEVER "*" — validate_production_safety() refuses to
# boot if it is, since allow_credentials=True + a wildcard origin would
# let any site make authenticated requests as a logged-in user.
# ---------------------------------------------------------
CORS_ORIGINS=https://app.yourdomain.com

# ---------------------------------------------------------
# Frontend — used to build password-reset links in emails.
# ---------------------------------------------------------
FRONTEND_BASE_URL=https://app.yourdomain.com

# ---------------------------------------------------------
# Email / SMTP — "console" is refused at startup when APP_ENV=production.
# ---------------------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=no-reply@yourdomain.com
SMTP_USE_TLS=true

# ---------------------------------------------------------
# Razorpay — global fallback account (used for any business that hasn't
# connected its own credentials via PUT /api/v1/integrations/RAZORPAY/credentials).
# Required at startup in production even if you expect every business to
# connect its own — see validate_production_safety().
# ---------------------------------------------------------
RAZORPAY_KEY_ID=CHANGE-ME
RAZORPAY_KEY_SECRET=CHANGE-ME
RAZORPAY_WEBHOOK_SECRET=CHANGE-ME

# ---------------------------------------------------------
# Zomato / Swiggy — leave blank if you don't have partner API access yet;
# every call correctly returns 503 until these are set AND a business has
# connected credentials via PUT /api/v1/integrations/{provider}/credentials.
# ---------------------------------------------------------
ZOMATO_API_BASE_URL=
ZOMATO_CLIENT_ID=
ZOMATO_CLIENT_SECRET=
ZOMATO_WEBHOOK_SECRET=
SWIGGY_API_BASE_URL=
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_WEBHOOK_SECRET=

QR_SESSION_EXPIRE_HOURS=6
