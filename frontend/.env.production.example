# =========================================================
# WhyNotGrace Frontend — PRODUCTION environment reference
#
# Reference only, not meant to be copied verbatim. Vite bakes VITE_* vars
# into the built JS bundle at BUILD time — this is never read by a
# running container, so for Docker it must be passed as a build ARG
# (see ../backend/docker-compose.yml's `frontend.build.args`), not set as
# a runtime environment variable on the container.
#
# There are no secrets here by design — the frontend never holds a
# secret of any kind (no API keys, no signing secrets). VITE_API_URL is
# a public URL, safe to ship in a public JS bundle.
# =========================================================

VITE_API_URL=https://api.yourdomain.com
