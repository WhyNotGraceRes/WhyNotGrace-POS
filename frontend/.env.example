# =========================================================
# WhyNotGrace Frontend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
#
# Vite only exposes variables prefixed VITE_, and it bakes them into the
# built bundle at BUILD time (not read at container runtime) — so when
# building a production image, VITE_API_URL must be passed as a Docker
# build ARG (see ../docker-compose.yml), not as a container environment
# variable.
# =========================================================

# Base URL of the backend API, with NO trailing slash and NO /api/v1
# suffix (the app appends /api/v1 itself — see src/api/client.ts).
VITE_API_URL=http://localhost:8000
